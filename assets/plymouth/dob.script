# ============================================
# DOB — Plymouth boot splash script
# ============================================
# Minimal script: DOB logo, title text, pulsing progress

@define DOB_RED       0xCC, 0x33, 0x44
@define DOB_WHITE     0xF0, 0xF0, 0xF0
@define DOB_FAINT     0x98, 0x88, 0xB0
@define DOB_BG        0x1A, 0x10, 0x30

normal:
    [root] {
        color = DOB_BG
    }

    [logo] {
        image = "dob-logo.png"
        x = (window-x - 256) / 2
        y = (window-y - 256) / 2
        width = 256
        height = 256
    }

    [title] {
        text = "D O B"
        font = "Sans Bold 42"
        x = (window-x) / 2
        y = ((window-y - 256) / 2) - 80
        color = DOB_WHITE
    }

    [subtitle] {
        text = "born from a dream"
        font = "Sans 20"
        x = (window-x) / 2
        y = ((window-y - 256) / 2) - 30
        color = DOB_FAINT
    }

    [progress] {
        image = "progress.png"
        x = (window-x - 64) / 2
        y = ((window-y + 256) / 2) + 24
        width = 64
        height = 64
    }
